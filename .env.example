# TRIDS Gas & Plumbing Environment Variables Example

# Database URL (SQLite for local, PostgreSQL for production e.g. Supabase/Neon)
DATABASE_URL="file:./dev.db"

# Generate unique secrets locally. Never commit real values.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
ADMIN_NAME="TRIDS Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_WITH_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD"

# Node Environment
NODE_ENV="development"

# Configurable Placeholders Default (Overridden in Admin Settings)
NEXT_PUBLIC_DEFAULT_PHONE="[PHONE NUMBER]"
NEXT_PUBLIC_DEFAULT_EMAIL="[EMAIL ADDRESS]"
NEXT_PUBLIC_DEFAULT_GAS_SAFE="[GAS SAFE REGISTRATION NUMBER]"
NEXT_PUBLIC_DEFAULT_ENGINEER="[ENGINEER NAME]"
NEXT_PUBLIC_DEFAULT_AREA="[SERVICE AREA]"

# Optional SMTP notification delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional OpenAI assistants (customer chat + admin writer)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# On Vercel, AI Gateway uses VERCEL_OIDC_TOKEN automatically when OPENAI_API_KEY is empty.
AI_GATEWAY_MODEL="openai/gpt-4o-mini"
