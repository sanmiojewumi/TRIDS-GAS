# TRIDS Gas & Plumbing Environment Variables Example

# Database URL (SQLite for local, PostgreSQL for production e.g. Supabase/Neon)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (Generate a strong random string)
SESSION_SECRET="trids-super-secret-key-change-in-production-2026"

# Node Environment
NODE_ENV="development"

# Configurable Placeholders Default (Overridden in Admin Settings)
NEXT_PUBLIC_DEFAULT_PHONE="[PHONE NUMBER]"
NEXT_PUBLIC_DEFAULT_EMAIL="[EMAIL ADDRESS]"
NEXT_PUBLIC_DEFAULT_GAS_SAFE="[GAS SAFE REGISTRATION NUMBER]"
NEXT_PUBLIC_DEFAULT_ENGINEER="[ENGINEER NAME]"
NEXT_PUBLIC_DEFAULT_AREA="[SERVICE AREA]"
